---
import SectionHeading from '../components/SectionHeading.astro';
import { publications, googleScholarUrl } from '../data/publications';

const filterYears = ['All', '2025', '2024', '2023', '2021', 'Earlier'];
---
<section id="publications" class="publications-section section-anchor" data-section="publications">
  <div class="shell">
    <div class="publications-topline">
      <SectionHeading eyebrow="02 / Publications" title="Selected Publications" description={`${publications.length} publications are retained from the original page.`} compact />
      <a class="button button-ghost" href={googleScholarUrl} target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>
    </div>

    <div class="publication-filters" role="group" aria-label="Filter publications by year">
      {filterYears.map((year, index) => (
        <button type="button" class:list={['publication-filter', { active: index === 0 }]} data-publication-filter={year}>{year}</button>
      ))}
    </div>

    <div class="publication-list" data-publication-list data-publication-limit="5">
      {publications.map((paper, index) => (
        <article
          class="publication-row"
          data-publication-row
          data-year={paper.year}
          data-publication-index={index}
          hidden={index >= 5}
        >
          <div class="publication-order">{String(index + 1).padStart(2, '0')}</div>
          <div class="publication-year">{paper.year}</div>
          <div class="publication-copy">
            <h3>{paper.title}</h3>
            <p class="publication-authors" set:html={paper.authorsHtml}></p>
            <p class="publication-venue">{paper.venue}</p>
          </div>
          <div class="publication-mark" aria-hidden="true">↗</div>
        </article>
      ))}
    </div>

    <div class="publication-expand-wrap">
      <button
        type="button"
        class="publication-expand"
        data-publication-expand
        aria-expanded="false"
      >
        <span data-publication-expand-label>Show more ({Math.max(0, publications.length - 5)})</span>
        <span class="publication-expand-icon" aria-hidden="true">↓</span>
      </button>
    </div>

    <div class="publications-footer">
      <span>All publications are retained; the complete list can be expanded above.</span>
      <a class="text-link" href={googleScholarUrl} target="_blank" rel="noopener noreferrer">View all publications on Google Scholar <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
