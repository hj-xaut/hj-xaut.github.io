---
interface MediaItem {
  image: string;
  alt: string;
  title: string;
  action: string;
  contain: boolean;
  document: boolean;
  portrait: boolean;
  wideDocument: boolean;
}

interface Props {
  id: string;
  items: readonly MediaItem[];
  mode: 'awards' | 'activities';
}

const { id, items, mode } = Astro.props;
---
<div class="rail-shell" data-gallery-shell>
  <div class="rail-toolbar">
    <div class="rail-count"><strong>{String(items.length).padStart(2, '0')}</strong> items</div>
    <div class="rail-controls">
      <button type="button" class="rail-button" data-gallery-prev={id} aria-label={`Previous ${mode}`}>←</button>
      <button type="button" class="rail-button" data-gallery-next={id} aria-label={`Next ${mode}`}>→</button>
    </div>
  </div>
  <div class="gallery-progress" aria-hidden="true"><span data-gallery-progress={id}></span></div>
  <div id={id} class:list={['media-rail', `${mode}-rail`]} data-gallery tabindex="0">
    {items.map((item, index) => (
      <article class:list={['media-card', { 'is-document': item.document, 'is-contain': item.contain, 'is-portrait': item.portrait, 'is-wide-document': item.wideDocument }]}>
        <button
          type="button"
          class="media-preview"
          data-lightbox-trigger
          data-lightbox-src={item.image}
          data-lightbox-alt={item.alt}
          data-lightbox-title={item.title}
        >
          <span class="media-order">{String(index + 1).padStart(2, '0')}</span>
          <span class="media-frame">
            <img src={item.image} alt={item.alt} loading="lazy" decoding="async" />
          </span>
          <span class="media-open">{item.action}</span>
        </button>
        <div class="media-card-body"><h3>{item.title}</h3></div>
      </article>
    ))}
  </div>
</div>
