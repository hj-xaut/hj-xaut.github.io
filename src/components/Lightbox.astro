<dialog class="media-lightbox" data-media-lightbox>
  <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close image viewer">×</button>
  <div class="lightbox-layout">
    <div class="lightbox-image-wrap"><img data-lightbox-image src="" alt="" /></div>
    <div class="lightbox-copy">
      <span class="eyebrow">Preview</span>
      <h2 data-lightbox-title></h2>
    </div>
  </div>
</dialog>
